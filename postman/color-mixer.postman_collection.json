  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Prueba común a todas las peticiones: rendimiento básico",
          "pm.test(\"Tiempo de respuesta < 1000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
        ]
      }
    }
