                "health"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Paleta de colores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const paleta = pm.response.json();",
                  "pm.test(\"Contiene los colores primarios\", () => {",
                  "  pm.expect(paleta.rojo).to.eql(\"#FF0000\");",
                  "  pm.expect(paleta.amarillo).to.eql(\"#FFFF00\");",
                  "  pm.expect(paleta.azul).to.eql(\"#0000FF\");",
                  "});",
                  "pm.test(\"Todos los valores son hexadecimales #RRGGBB\", () => {",
                  "  Object.values(paleta).forEach(v => pm.expect(v).to.match(/^#[0-9A-F]{6}$/));",
                  "});",
                  "pm.collectionVariables.set(\"totalColores\", Object.keys(paleta).length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/colores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "colores"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Mezclas de pintura",
      "item": [
        {
          "name": "Amarillo + azul = verde",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test(\"Color resultante #00FF00\", () => pm.expect(body.hex).to.eql(\"#00FF00\"));",
                  "pm.test(\"Nombre aproximado: verde\", () => pm.expect(body.nombreAproximado).to.eql(\"verde\"));",
                  "pm.test(\"Modo PINTURA\", () => pm.expect(body.modo).to.eql(\"PINTURA\"));",
                  "pm.test(\"Canales RGB coherentes con el hex\", () => {",
                  "  const hex = \"#\" + [body.r, body.g, body.b].map(v => v.toString(16).padStart(2, \"0\")).join(\"\").toUpperCase();",
                  "  pm.expect(hex).to.eql(body.hex);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/colores/mezclar?colores=amarillo,azul",
              "host": [
                "{{baseUrl}}"
